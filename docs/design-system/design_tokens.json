  "aiConstraints": {
    "enforceComponentOwnership": true,
    "neverRenderTableOutsideCard": true,
    "neverAddTitleToTable": true,
    "cardOwnsHeaderAndLayout": true,
    "tableOwnsDataAndStates": true,
    "cardHeaderRightGroupOnlyForPrimaryAction": true,
    "cardHeaderRightGroupMayBeEmpty": true,
    "neverPlacePillsInCardHeaderRightGroup": true,
    "neverPlaceFiltersInCardHeaderRightGroup": true,
    "cardHeaderLeftGroupUsesOnePatternAtATime": true,
    "neverMixPillsAndFiltersInCardHeader": true,
    "neverMixPillsAndButtonGroupsInCardHeader": true,
    "neverMixFiltersAndButtonGroupsInCardHeader": true,
    "cardHeaderBottomRowMustNotRenderIfEmpty": true,
    "cardHeaderPrimaryActionUsesFilledPrimaryButton": true,
    "cardHeaderPrimaryActionUsesPlusIcon": true,
    "cardHeaderUtilityActionsUseOutlinedIconOnlyButtons": true,
    "cardHeaderUtilityActionsMustNotUseCircularIconButtons": true,
    "neverMixBootstrapNavWithPills": true,
    "secondaryCardBodySectionNavUsesNavTabsTopNotPills": true,
    "navTabsTopInactiveHoverMustUsePrimaryBorderNotTransparentInactiveBorder": true,
    "neverUseOutlinedIconOnlyForTableActions": true,
    "tableActionCircularIconButtonsMustUseDefaultIconVariant": true,
    "tableActionsColumnButtonsHiddenUntilRowHoverOrFocusWithin": true,
    "iconOnlyButtonsMustUseSizeTokens": true,
    "pillsMustUseFixedFontSize": true,
    "neverUseResponsiveTypographyForPills": true,
    "neverInventStylesOutsideTokens": true,
    "preferSemanticTokensOverCorePalette": true,
    "preferComponentTokensForAlertsBadgesAndButtons": true,
    "outlinedButtonHoverActiveUseExplicitSurfaceTokens": true,
    "keepLegacyNeutralDuringMigration": true,
    "treatBadgeWarningAsLegacyCompatibility": true,
    "tableRowsMustUseFixedHeight": true,
    "tableRowsMustUseBorderSeparators": true,
    "tableCellsMustResetBootstrapVerticalPadding": true,
    "nativeTableRowsMustApplyHeightToTrThAndTd": true,
    "nativeTablesMustUseBorderCollapse": true,
    "tableCellContentMustNotExpandRows": true,
    "bodyContentMustUseSectionGap": true,
    "symphonicaAppSidebarMustUseNavSidebarTokensAndMaterialOutlinedIcons": true,
    "symphonicaSidebarCollapsedMustHideScrollbar": true,
    "neverNestPrimaryCardInsideSecondaryCard": true,
    "secondaryCardNestedInPrimaryMustUseNestedInPrimaryBackgroundToken": true
  }
